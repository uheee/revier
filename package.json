{
  "name": "revier",
  "version": "0.1.0",
  "description": "A local Git code review assistant built with Tauri, Vue, and Rust.",
  "author": "uheee",
  "homepage": "https://github.com/uheee/revier",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "glob": "10.5.0",
      "postcss": "8.5.18"
    }
  },
  "scripts": {
    "dev": "pnpm tauri dev",
    "build": "pnpm typecheck && pnpm generate:bindings:check && pnpm tauri build",
    "preview": "vite preview",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm typecheck && eslint .",
    "check:deps": "knip",
    "audit:deps": "pnpm audit --audit-level high --registry https://registry.npmjs.org",
    "generate:bindings": "cargo run -p revier-analysis -- export-bindings --out src/renderer/generated/bindings.ts",
    "generate:bindings:check": "pnpm generate:bindings && git diff --exit-code -- src/renderer/generated/bindings.ts"
  },
  "dependencies": {
    "@pinia/colada": "^1.4.2",
    "@shikijs/monaco": "^4.3.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@vueuse/components": "^10.11.0",
    "@vueuse/core": "^10.11.0",
    "@vueuse/shared": "^10.11.1",
    "diff": "^5.2.0",
    "lucide-vue-next": "^0.468.0",
    "minimatch": "^10.2.6",
    "monaco-editor": "^0.55.1",
    "naive-ui": "^2.44.1",
    "pinia": "^2.2.2",
    "shiki": "^4.3.1",
    "vue": "^3.5.0",
    "vue-router": "^4.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2",
    "@types/node": "^22.5.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.0",
    "knip": "^6.29.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.0.29"
  }
}
