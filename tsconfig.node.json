{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "skipLibCheck": true
  },
  "include": [
    "electron.vite.config.ts",
    "playwright.config.ts",
    "vitest.perf.config.ts",
    "vitest.config.ts",
    "src/analysis-core/**/*.ts",
    "src/cli/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/renderer/**/*.d.ts",
    "src/renderer/composables/**/*.ts",
    "src/renderer/stores/**/*.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts"
  ]
}
